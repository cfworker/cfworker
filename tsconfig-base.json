{
  "compilerOptions": {
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "typeRoots": [],
    "types": [],
    "paths": {
      "@cfworker/*": ["./packages/*"]
    },
    "composite": true,
    "isolatedModules": true,
    "isolatedDeclarations": true
  }
}
