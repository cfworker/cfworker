{
  "name": "@cfworker/site",
  "version": "3.0.3",
  "description": "The cfworker.dev website",
  "repository": "https://github.com/cfworker/cfworker",
  "author": "Jeremy Danyow <jdanyow@gmail.com>",
  "homepage": "https://github.com/cfworker/cfworker/tree/master/packages/site/README.md",
  "license": "MIT",
  "private": true,
  "browserslist": "last 2 Chrome versions",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build --workspace @cfworker/web && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --conditions=worker,browser --define:process.env.NODE_ENV='\"production\"' --outfile=dist/index.js",
    "typecheck": "tsc --project tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cfworker/web": "^6.1.0",
    "@cloudflare/workers-types": "^5.20261030.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
