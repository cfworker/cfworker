    "start-web": "wrangler dev src/web/index.ts",
    "start": "npm run start-web"
  },
  "dependencies": {
    "@cfworker/cosmos": "^4.0.6",
    "@cfworker/jwt": "^7.0.5",
    "@cfworker/sentry": "^5.0.4",
