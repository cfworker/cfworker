{
  "name": "@cfworker/web",
  "version": "5.1.0",
  "description": "Web framework for Cloudflare Workers and service workers, inspired by Koa and fastify",
  "keywords": [
    "middleware",
    "cloudflare",
    "worker",
    "workers",
    "service-worker"
  ],
  "repository": "https://github.com/cfworker/cfworker",
  "author": "Jeremy Danyow <jdanyow@gmail.com>",
  "homepage": "https://github.com/cfworker/cfworker/tree/master/packages/web/README.md",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run prepare --workspace @cfworker/json-schema && tshy",
    "build": "npm run build --workspace @cfworker/json-schema && tshy",
    "typecheck": "tsc --project tsconfig.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "pretest": "esbuild test/test.ts --target=esnext --bundle --format=esm --conditions=worker,browser --outdir=dist-test --ignore-annotations",
    "test": "node ../../test.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@hapi/bourne": "^4.0.1",
    "@types/statuses": "^2.0.6",
    "cookie": "^2.0.1",
    "html-escaper": "^3.0.3",
    "negotiator": "^1.1.0",
    "path-to-regexp": "7.1.0",
    "statuses": "^2.0.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsonpointer": "^5.0.1",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "tshy": {
    "project": "./tsconfig.build.json",
    "exports": {
      "./package.json": "./package.json",
      ".": "./src/index.ts"
    }
  }
}
